# BMS Frontend Environment Configuration
# Copy this file to .env.local and update with your credentials for Azure deployment

# Login credentials for the Budget Management System
# IMPORTANT: Change these to your desired username and password before deploying to Azure
VITE_LOGIN_USERNAME=admin
VITE_LOGIN_PASSWORD=secure123

# Session timeout (in minutes) - optional
VITE_SESSION_TIMEOUT=30

# Supabase Configuration (Required for Production)
# Get these from your Supabase project settings
# 1. Go to https://supabase.com/
# 2. Create a new project or select existing
# 3. Copy the Project URL and Anon Key from Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Supabase Service Role Key (for server-side operations only)
# DO NOT expose this in the frontend
# VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
